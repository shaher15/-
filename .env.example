# انسخ هذا الملف إلى .env.local وضع فيه مفتاح Groq الخاص بك محليًا.
# لا تضع مفاتيح حقيقية في هذا الملف (.env.example) — هو للتوثيق فقط ويُرفع إلى المستودع.

# مفتاح Groq API — احصل عليه من https://console.groq.com
GROQ_API_KEY=

# نموذج Qwen المستخدم عبر Groq لإعادة صياغة نصوص الطلبات
GROQ_MODEL=qwen/qwen3.6-27b

# غير مُفعّلة بعد — محجوزة للتكامل المستقبلي مع مزوّد لقاءات مرئي حقيقي (مثل LiveKit).
# لا تُستخدم حاليًا في الكود؛ اللقاءات المرئية تعمل حاليًا بوضع معاينة كاميرا/ميكروفون محلي فقط.
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
